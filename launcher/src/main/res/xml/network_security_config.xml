<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 не знає нових кореневих сертифікатів Let's Encrypt (ISRG Root X1/X2),
  а на них працює Open-Meteo (погода). Додаємо їх до системних, лише для Домівки.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
